[Unit]
Description=Clips Studio Backend Service
After=network.target

[Service]
Type=simple
# Server user
User=ubuntu
# Absolute path to your project directory on the server
WorkingDirectory=/home/ubuntu/clip_studio
# Path to uvicorn inside the python virtual environment
ExecStart=/home/ubuntu/clip_studio/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 1

# Auto restart on crash
Restart=always
RestartSec=5s

# Environment variables
Environment="PYTHONUNBUFFERED=1"

# Security & sandbox settings
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/clip_studio

[Install]
WantedBy=multi-user.target
